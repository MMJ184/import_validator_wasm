{
    "name": "@import-validator/node",
    "version": "0.2.0",
    "private": true,
    "description": "Node.js server-side wrapper for the ImportValidator WASM engine",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "node --test test/*.test.mjs"
    },
    "dependencies": {
        "@import-validator/core": "workspace:*"
    },
    "devDependencies": {
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=20"
    }
}
