{
  "name": "@import-validator/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Browser SDK for ImportValidator — createValidator() event-driven API",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@import-validator/core": "workspace:*",
    "@import-validator/worker": "workspace:*"
  }
}
