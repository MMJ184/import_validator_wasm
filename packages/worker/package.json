{
    "name": "@import-validator/worker",
    "version": "0.2.0",
    "private": true,
    "description": "Web Worker pipeline for the ImportValidator WASM engine (CSV + XLSX)",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./worker": {
            "types": "./dist/worker.d.ts",
            "import": "./dist/worker.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "rimraf dist && tsc -p tsconfig.json && node scripts/bundle-worker.mjs",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "pnpm run build && node --test test/**/*.test.mjs"
    },
    "dependencies": {
        "@import-validator/core": "workspace:*"
    },
    "devDependencies": {
        "esbuild": "^0.28.1"
    }
}
