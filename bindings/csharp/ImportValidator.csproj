<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>ImportValidator</RootNamespace>
    <AssemblyName>ImportValidator</AssemblyName>
    <Version>0.2.0</Version>
